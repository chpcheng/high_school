.page { padding-bottom: 40rpx; }

.hero {
  background: linear-gradient(135deg, #4A6CF7, #6A8BFF);
  color: #fff;
  padding: 48rpx 40rpx 40rpx;
}
.hero-title { font-size: 44rpx; font-weight: 700; }
.hero-sub { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }
.hero-stats {
  display: flex;
  margin-top: 36rpx;
}
.stat { flex: 1; text-align: center; }
.stat-num { font-size: 40rpx; font-weight: 700; }
.stat-label { font-size: 22rpx; opacity: 0.85; margin-top: 6rpx; }

.quick {
  display: flex;
  margin: -40rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(74, 108, 247, 0.12);
  position: relative;
}
.quick-item { flex: 1; text-align: center; }
.quick-icon {
  width: 88rpx; height: 88rpx;
  border-radius: 50%; margin: 0 auto 12rpx;
  display: flex; align-items: center; justify-content: center;
}
.quick-text { font-size: 24rpx; color: #2B2F36; }

.section-title {
  font-size: 30rpx; font-weight: 600;
  margin: 36rpx 28rpx 8rpx;
}

.weak-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F1F5;
}
.weak-item:last-child { border-bottom: none; }
.weak-name { font-size: 28rpx; font-weight: 500; }
.weak-meta { font-size: 22rpx; color: #A0A5B0; margin-top: 6rpx; }
.weak-right { display: flex; align-items: center; }
.weak-rate { font-size: 26rpx; font-weight: 600; margin-right: 12rpx; }
.weak-go { display: flex; align-items: center; font-size: 24rpx; color: #4A6CF7; }
