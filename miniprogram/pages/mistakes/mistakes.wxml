<view class="page">
  <!-- 学科筛选 -->
  <scroll-view scroll-x class="subject-bar" wx:if="{{hasSubjects}}">
    <view class="chip {{subjectFilter === '' ? 'active' : ''}}" data-value="" bindtap="setSubject">全部学科</view>
    <view class="chip {{subjectFilter === item._id ? 'active' : ''}}"
          wx:for="{{subjects}}" wx:key="_id" data-value="{{item._id}}" bindtap="setSubject">{{item.name}}</view>
  </scroll-view>

  <!-- 状态筛选 -->
  <view class="status-bar">
    <view class="chip {{statusFilter === item.value ? 'active' : ''}}"
          wx:for="{{statusTabs}}" wx:key="value" data-value="{{item.value}}" bindtap="setStatus">{{item.label}}</view>
  </view>

  <!-- 错题列表 -->
  <view class="list">
    <view class="card mistake" wx:for="{{list}}" wx:key="_id">
      <view class="m-head">
        <text class="tag type">{{item.typeText}}</text>
        <text class="tag diff">{{item.difficultyText}}</text>
        <text class="tag subj">{{item.subjectName}}</text>
        <text class="m-count" wx:if="{{item.wrongCount > 1}}">错 {{item.wrongCount}} 次</text>
      </view>
      <view class="m-stem ellipsis" data-questionid="{{item.questionId}}" bindtap="viewDetail">{{item.stem}}</view>
      <view class="m-meta">
        <text>{{item.knowledgePointName || ''}}</text>
        <text>{{item.dateText}}</text>
      </view>
      <view class="m-note ellipsis" wx:if="{{item.hasNote}}">📝 {{item.note}}</view>
      <view class="m-actions">
        <text class="link" data-questionid="{{item.questionId}}" bindtap="viewDetail">看解析</text>
        <text class="link" data-questionid="{{item.questionId}}" bindtap="redo">重做</text>
        <text class="link" data-id="{{item._id}}" data-note="{{item.note}}" bindtap="openNote">{{item.hasNote ? '改笔记' : '写笔记'}}</text>
        <text class="link" data-id="{{item._id}}" data-status="{{item.status}}" bindtap="toggleStatus">
          {{item.status === 'open' ? '标记掌握' : '撤销掌握'}}
        </text>
        <text class="link danger" data-id="{{item._id}}" bindtap="remove">移除</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && listEmpty}}">暂无错题，继续保持～</view>
  <view class="empty" wx:if="{{finished && hasList}}">没有更多了</view>
</view>

<!-- 错题笔记弹窗 -->
<view class="modal-mask" wx:if="{{noteModalVisible}}" bindtap="closeNote">
  <view class="modal" catchtap="noop">
    <view class="modal-title">错题笔记</view>
    <textarea class="modal-textarea" maxlength="200" value="{{noteText}}" bindinput="onNoteInput"
              placeholder="记录易错点、解题思路…" auto-focus />
    <view class="modal-count">{{noteLength}}/200</view>
    <view class="modal-btns">
      <button class="btn-ghost modal-btn" bindtap="closeNote">取消</button>
      <button class="btn-primary modal-btn" bindtap="saveNote">保存</button>
    </view>
  </view>
</view>
