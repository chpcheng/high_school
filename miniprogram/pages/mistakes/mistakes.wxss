.page { padding-bottom: 40rpx; }

.subject-bar { white-space: nowrap; padding: 20rpx 24rpx 4rpx; box-sizing: border-box; }
.subject-bar .chip { display: inline-block; margin-right: 16rpx; }

.status-bar { padding: 12rpx 24rpx; }

.chip {
  padding: 10rpx 28rpx; border-radius: 40rpx;
  background: #F0F1F5; color: #2B2F36; font-size: 24rpx;
}
.chip.active { background: #EAF0FF; color: #4A6CF7; font-weight: 600; }

.m-head { display: flex; align-items: center; margin-bottom: 12rpx; }
.tag { margin-right: 10rpx; }
.tag.type { background: #EAF0FF; color: #4A6CF7; }
.tag.diff { background: #F0F1F5; color: #8A8F99; }
.tag.subj { background: #E8F8EF; color: #2FB26A; }
.m-count { margin-left: auto; font-size: 22rpx; color: #E8564A; }

.m-stem { font-size: 28rpx; line-height: 1.6; margin-bottom: 12rpx; }
.m-meta {
  display: flex; justify-content: space-between;
  font-size: 22rpx; color: #A0A5B0; margin-bottom: 16rpx;
}
.m-actions { display: flex; flex-wrap: wrap; gap: 20rpx 28rpx; border-top: 1rpx solid #F0F1F5; padding-top: 16rpx; }
.link { font-size: 26rpx; color: #4A6CF7; }
.link.danger { color: #E8564A; }

/* 笔记预览 */
.m-note {
  font-size: 24rpx; color: #8A6D3B;
  background: #FFF8E8; border-radius: 8rpx;
  padding: 12rpx 16rpx; margin-bottom: 16rpx;
}

/* 笔记弹窗 */
.modal-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(43, 47, 54, 0.5);
  display: flex; align-items: flex-end;
  z-index: 100;
}
.modal {
  width: 100%; background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.modal-title { font-size: 32rpx; font-weight: 700; margin-bottom: 24rpx; }
.modal-textarea {
  width: 100%; height: 240rpx; box-sizing: border-box;
  background: #F5F6FA; border-radius: 16rpx;
  padding: 20rpx; font-size: 28rpx; line-height: 1.6;
}
.modal-count { text-align: right; font-size: 22rpx; color: #A0A5B0; margin-top: 12rpx; }
.modal-btns { display: flex; gap: 24rpx; margin-top: 24rpx; }
.modal-btn { flex: 1; }
