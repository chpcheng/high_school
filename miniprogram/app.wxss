/* app.wxss —— 全局样式 */
page {
  background: #F5F6FA;
  font-size: 28rpx;
  color: #2B2F36;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
}

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(43, 47, 54, 0.04);
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #4A6CF7, #6A8BFF);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}
.btn-primary::after { border: none; }
.btn-primary[disabled] {
  background: #C9D2F0;
  color: #FFFFFF;
}

/* 次按钮 */
.btn-ghost {
  background: #FFFFFF;
  color: #4A6CF7;
  border: 2rpx solid #4A6CF7;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  text-align: center;
}
.btn-ghost::after { border: none; }

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  line-height: 1.6;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #A0A5B0;
  font-size: 26rpx;
  padding: 120rpx 0;
}

/* 文本省略 */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 富文本图片自适应 */
.rich-text image { max-width: 100%; }

/* 全局加载/空/失败三态 */
.state-loading, .state-empty, .state-error {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 160rpx 40rpx; text-align: center;
}
.state-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.state-text { font-size: 26rpx; color: #A0A5B0; }
.state-btn {
  margin-top: 32rpx; padding: 16rpx 64rpx; border-radius: 40rpx;
  background: #4A6CF7; color: #fff; font-size: 28rpx;
}
.state-btn.ghost { background: #fff; color: #4A6CF7; border: 2rpx solid #4A6CF7; }
